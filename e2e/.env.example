# BlackBar E2E configuration. Copy to `.env` and adjust for your stack.
# All values have defaults (see lib/config.ts); override only what differs.

# Where the frontend is served (Playwright drives this).
E2E_BASE_URL=http://localhost:3000

# Where the backend API is reachable FROM THE HOST (global-setup seeds via this).
# The docker-compose stack exposes the backend on host port 8000.
E2E_API_URL=http://localhost:8000/api/v1

# An EXISTING admin/owner account. The stack must already be bootstrapped
# (see README "Prerequisites") — the E2E harness cannot create the first
# owner via the public API (owner activation needs an emailed token).
#
# The defaults below match the recommended bootstrap command in the README:
#   ADMIN_EMAIL=admin@blackbar.test ADMIN_PASSWORD='E2eAdmin!2345' \
#   ADMIN_NAME='E2E Admin' ORG_NAME='BlackBar E2E' SEED_DEMO=n SEED_TRUSTLAB=n \
#   bash setup.sh
E2E_ADMIN_EMAIL=admin@blackbar.test
E2E_ADMIN_PASSWORD=E2eAdmin!2345
E2E_ADMIN_NAME=E2E Admin

# Password assigned to every seeded role user (analyst/user/guest). Meets the
# app's complexity rules (upper, lower, digit, special, >=8).
E2E_USER_PASSWORD=E2eUser!2345
