# Server Configuration
PORT=8000
HOST=0.0.0.0
# The backend gates on ENVIRONMENT (not NODE_ENV). "production" disables the
# public /docs endpoints and requires JWT_SECRET to be set in this file.
ENVIRONMENT=development

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/blackbar
MONGODB_DB_NAME=blackbar

# MongoDB credentials (consumed by the mongodb container in docker-compose.yml)
MONGO_USERNAME=blackbar
MONGO_PASSWORD=changeme

# Authentication
# Leave empty and run ./setup.sh to generate one, or set it yourself with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Placeholder or low-entropy values are rejected; production refuses to start.
JWT_SECRET=
# Access-token lifetime, in integer minutes. Default: 60.
JWT_EXPIRATION=60

# Development Mode (NEVER set to true in production!)
DEV_MODE=false

# Reverse proxy and public URL
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is
# trusted for client IPs (rate limits, audit). Empty: header ignored, and
# behind a proxy every client then shares ONE rate-limit bucket.
# The shipped docker-compose files set this to the compose network
# (BLACKBAR_NETWORK_SUBNET below) when left empty here, because the backend
# is only reached through the frontend nginx/Vite container. Set it yourself
# when you run the backend outside compose behind another proxy.
TRUSTED_PROXIES=
# Subnet of the compose network (docker-compose.yml). Change it if it
# overlaps a network on your host; TRUSTED_PROXIES follows it by default.
BLACKBAR_NETWORK_SUBNET=172.30.87.0/24
# Comma-separated Host header allowlist. Empty: no Host check.
TRUSTED_HOSTS=
# Base URL used in emailed links. Falls back to FRONTEND_URL, then
# http://localhost:3000. Never derived from the request Host header.
PUBLIC_BASE_URL=

# Rate limiting
# Counter storage. memory:// is per process; use redis://host:6379 when
# running several workers.
RATELIMIT_STORAGE_URI=memory://
# Limits per client (login/token/lookup) or per user (LLM).
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_AUTH_TOKEN=10/minute
RATE_LIMIT_PUBLIC_LOOKUP=10/minute
RATE_LIMIT_LLM=10/minute

# LLM Configuration
# Fernet key that encrypts stored LLM API keys and custom header values.
# Leave empty and run ./setup.sh to generate one, or set it yourself with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production refuses to start without a valid key, even when no LLM is
# configured. Keep it: stored keys cannot be decrypted with a different one.
# Rotate with "new,old" (see backend/src/llm/encryption.py).
LLM_API_KEY_ENCRYPTION_KEY=

# LLM egress and analysis limits. Values shown are the defaults.
# Allow LLM endpoints on loopback/private networks, over http or https.
# Needed for a local model server, e.g. http://ollama:11434 (a compose
# service), http://host.docker.internal:11434 (the Docker host; inside a
# container "localhost" is the backend itself) or http://10.0.0.5:8000.
# With it on, plain http:// is accepted for loopback, RFC 1918 / ULA /
# CGNAT addresses, single-label names and *.docker.internal. Public hosts
# always need https. Link-local and cloud metadata addresses (169.254.0.0/16,
# fe80::/10, fd00:ec2::254, 100.100.100.200, metadata.google.internal) are
# always refused.
LLM_ALLOW_PRIVATE_ENDPOINTS=false
# Send the case title and filename with prompts (off for data minimisation).
LLM_SEND_CASE_CONTEXT=false
# Maximum characters of a document sent for analysis.
LLM_MAX_ANALYSIS_CHARS=200000
# Long documents are analysed in chunks of this size, with this overlap.
LLM_CHUNK_CHARS=12000
LLM_CHUNK_OVERLAP=400
# Maximum suggestions kept per document.
LLM_MAX_SUGGESTIONS=200
# Retries on 429/5xx/connection errors; first backoff delay in seconds.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
# HTTP timeouts to the LLM provider, in seconds.
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=120
# Minimum seconds between LLM analyses of the same document.
LLM_REGENERATE_COOLDOWN_SECONDS=60
# Days to keep AI suggestion feedback records.
AI_FEEDBACK_RETENTION_DAYS=90

# Cohere API key (optional - only required if seeding Cohere LLM configs)
COHERE_API_KEY=

# Magic Link Rate Limiting (RFC-007)
# For production, use 3 requests per 1 hour. For testing, increase as needed.
MAGIC_LINK_RATE_LIMIT_MAX=3
MAGIC_LINK_RATE_LIMIT_HOURS=1

# Public User Session Duration (RFC-007)
# How long public users stay logged in (in hours). Default: 8 hours.
PUBLIC_USER_SESSION_HOURS=8

# SendGrid Email (RFC-007)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@blackbar.app
SENDGRID_FROM_NAME=Blackbar FOI System

# Document Processing
# Upload size cap in MB for all upload routes. Raising it above 100 also
# needs client_max_body_size raised in frontend/nginx.conf.
MAX_UPLOAD_SIZE_MB=100
# PDFs with more pages than this are rejected at upload (413).
BLACKBAR_MAX_PDF_PAGES=2000
ALLOWED_FILE_TYPES=pdf,docx,eml

# Logging
LOG_LEVEL=info

# Production deployment
# Persistent data directory for docker-compose.prod.yml volumes (mongodb).
# Defaults to ./data alongside docker-compose.prod.yml if unset.
BLACKBAR_DATA_DIR=./data
